// The width model of the ansi package.
//
// The width of a text is the number of columns that a terminal gives it.
// The model follows the Unicode rules for grapheme clusters and the East
// Asian width data of the Unicode Character Database.
//
// A cluster holds a base code point and the marks that follow it. A
// joiner joins two emoji into one cluster. A pair of regional indicators is
// one flag. The width of a cluster is two for an emoji, two for a wide
// code point, and one for the rest. A mark, a control and a format take
// no column.
//
// The tables at the end of the file come from the Unicode data files. The
// script scripts/build-width.py makes them.

namespace ansi;

import std;
import escape;

// in_ranges tells whether the code point cp is in one of the ranges. The
// ranges are sorted, so the search is a binary search.
fn in_ranges(lo: u32[:], hi: u32[:], cp: i64) -> bool {
    var low = 0;
    var high = lo.len - 1;
    while low <= high {
        let mid = (low + high) / 2;
        if cp < lo[mid] {
            high = mid - 1;
        } else if cp > hi[mid] {
            low = mid + 1;
        } else {
            return true;
        }
    }
    return false;
}

// is_wide tells whether the code point takes two columns.
fn is_wide(cp: i64) -> bool {
    return in_ranges(WIDE_LO[..], WIDE_HI[..], cp);
}

// is_ambiguous tells whether the code point has an ambiguous width.
fn is_ambiguous(cp: i64) -> bool {
    return in_ranges(AMBIGUOUS_LO[..], AMBIGUOUS_HI[..], cp);
}

// is_emoji tells whether the code point has the Emoji property.
fn is_emoji(cp: i64) -> bool {
    return in_ranges(EMOJI_LO[..], EMOJI_HI[..], cp);
}

// is_pres tells whether the emoji shows as a picture without a selector.
fn is_pres(cp: i64) -> bool {
    return in_ranges(PRES_LO[..], PRES_HI[..], cp);
}

// is_zero tells whether the code point takes no column.
fn is_zero(cp: i64) -> bool {
    return in_ranges(ZERO_LO[..], ZERO_HI[..], cp);
}

// is_ender tells whether the code point ends a cluster.
fn is_ender(cp: i64) -> bool {
    return in_ranges(END_LO[..], END_HI[..], cp);
}

// is_join tells whether the code point joins the cluster before it.
fn is_join(cp: i64) -> bool {
    return in_ranges(JOIN_LO[..], JOIN_HI[..], cp);
}

// is_regional tells whether the code point is a regional indicator.
fn is_regional(cp: i64) -> bool {
    return cp >= 0x1F1E6 && cp <= 0x1F1FF;
}

// utf8_size returns the number of bytes of the UTF-8 sequence that starts
// with the byte b. It returns 1 for a malformed byte.
fn utf8_size(b: u8) -> i64 {
    if b >= 0xF0 { return 4; }
    if b >= 0xE0 { return 3; }
    if b >= 0xC0 { return 2; }
    return 1;
}

// decode_utf8 returns the code point of the sequence at i. A malformed
// sequence gives U+FFFD.
fn decode_utf8(s: u8[:], i: i64) -> i64 {
    let size = utf8_size(s[i]);
    if i + size > s.len { return 0xFFFD; }
    if size == 1 {
        if s[i] >= 0x80 { return 0xFFFD; }
        return s[i];
    }
    // The bytes go into i64 values first. The shifts then keep their
    // values, because a shift on a u8 would lose the high bits.
    if size == 2 {
        if (s[i] & 0xE0) != 0xC0 || (s[i + 1] & 0xC0) != 0x80 { return 0xFFFD; }
        let a: i64 = s[i];
        let b: i64 = s[i + 1];
        return (a & 0x1F) << 6 | (b & 0x3F);
    }
    if size == 3 {
        if (s[i] & 0xF0) != 0xE0 || (s[i + 1] & 0xC0) != 0x80 || (s[i + 2] & 0xC0) != 0x80 { return 0xFFFD; }
        let a: i64 = s[i];
        let b: i64 = s[i + 1];
        let c: i64 = s[i + 2];
        return (a & 0x0F) << 12 | (b & 0x3F) << 6 | (c & 0x3F);
    }
    if (s[i] & 0xF8) != 0xF0 || (s[i + 1] & 0xC0) != 0x80 || (s[i + 2] & 0xC0) != 0x80 || (s[i + 3] & 0xC0) != 0x80 { return 0xFFFD; }
    let a: i64 = s[i];
    let b: i64 = s[i + 1];
    let c: i64 = s[i + 2];
    let d: i64 = s[i + 3];
    return (a & 0x07) << 18 | (b & 0x3F) << 12 | (c & 0x3F) << 6 | (d & 0x3F);
}

// cp_size gives the number of bytes of the code point at i. A sequence
// cut at the end of the text has fewer bytes.
fn cp_size(s: u8[:], i: i64) -> i64 {
    var size = utf8_size(s[i]);
    if i + size > s.len { size = s.len - i; }
    return size;
}

// hangul_class gives the class of a Hangul code point. The classes are 0
// for none, 1 for L, 2 for V, 3 for T, 4 for LV and 5 for LVT.
fn hangul_class(cp: i64) -> i64 {
    if cp >= 0x1100 && cp <= 0x115F { return 1; }
    if cp >= 0xA960 && cp <= 0xA97C { return 1; }
    if cp >= 0x1160 && cp <= 0x11A7 { return 2; }
    if cp >= 0xD7B0 && cp <= 0xD7C6 { return 2; }
    if cp >= 0x11A8 && cp <= 0x11FF { return 3; }
    if cp >= 0xD7CB && cp <= 0xD7FB { return 3; }
    if cp >= 0xAC00 && cp <= 0xD7A3 {
        if (cp - 0xAC00) % 28 == 0 { return 4; }
        return 5;
    }
    return 0;
}

// hangul_joins tells whether a code point of the class next joins a code
// point of the class before.
fn hangul_joins(before: i64, next: i64) -> bool {
    if before == 1 { return next == 1 || next == 2 || next == 4 || next == 5; }
    if before == 2 || before == 4 { return next == 2 || next == 3; }
    if before == 3 || before == 5 { return next == 3; }
    return false;
}

// cluster_columns gives the number of columns of a cluster. The base is
// the first code point of the cluster. The regional count is the number of
// regional indicators in the cluster. The keycap flag says that the
// cluster holds the enclosing keycap mark.
fn cluster_columns(base: i64, regional: i64, keycap: bool, emoji_seq: bool, ambiguous_is_narrow: bool) -> i64 {
    if is_zero(base) { return 0; }
    if keycap { return 2; }
    if regional >= 2 { return 2; }
    if is_pres(base) { return 2; }
    if emoji_seq && is_emoji(base) { return 2; }
    if is_wide(base) { return 2; }
    if is_ambiguous(base) {
        if ambiguous_is_narrow { return 1; }
        return 2;
    }
    return 1;
}

// cluster_scan reads the cluster that starts at i. It gives the index after
// the cluster and the number of columns of the cluster.
//
// A mark joins the cluster. A joiner joins the cluster and the emoji that
// follows it. A regional indicator joins a regional indicator when the
// count of them is odd. A Hangul syllable joins the syllable before it.
fn cluster_scan(s: u8[:], i: i64, ambiguous_is_narrow: bool, end: i64&, columns: i64&) {
    let base = decode_utf8(s, i);
    var p = i + cp_size(s, i);
    var regional = 0;
    if is_regional(base) { regional = 1; }
    var pict = is_emoji(base);
    var zwj_ok = false;
    var keycap = false;
    var emoji_seq = false;
    var last_class = hangul_class(base);
    while p < s.len {
        let c = decode_utf8(s, p);
        let csize = cp_size(s, p);
        if is_ender(c) { break; }
        if is_join(c) {
            if c == 0x20E3 { keycap = true; }
            if c == 0xFE0F { emoji_seq = true; }
            p += csize;
            continue;
        }
        if c == 0x200D {
            zwj_ok = pict;
            if pict { emoji_seq = true; }
            p += csize;
            continue;
        }
        if zwj_ok && is_emoji(c) {
            pict = true;
            zwj_ok = false;
            p += csize;
            continue;
        }
        if is_regional(c) && regional % 2 == 1 {
            regional += 1;
            p += csize;
            continue;
        }
        let cclass = hangul_class(c);
        if cclass != 0 && hangul_joins(last_class, cclass) {
            last_class = cclass;
            p += csize;
            continue;
        }
        break;
    }
    end = p;
    columns = cluster_columns(base, regional, keycap, emoji_seq, ambiguous_is_narrow);
}

// char_width returns the number of columns of one code point. It returns 2
// for an emoji and for a wide character, 0 for a mark and for a control,
// and 1 for the rest.
fn char_width(cp: i64) -> i64 {
    if is_zero(cp) { return 0; }
    if is_pres(cp) || is_wide(cp) { return 2; }
    return 1;
}

// len_with returns the visible length of s in columns. It skips the escape
// sequences unless count_ansi is true. An ambiguous code point takes one
// column unless ambiguous_is_narrow is false.
fn len_with(s: u8[:], ambiguous_is_narrow: bool, count_ansi: bool) -> i64 {
    var text: u8[>..] = [];
    if count_ansi {
        text.append(s);
    } else {
        strip(text, s);
    }
    var total = 0;
    var i = 0;
    while i < text.len {
        var end = 0;
        var columns = 0;
        cluster_scan(text, i, ambiguous_is_narrow, end, columns);
        total += columns;
        i = end;
    }
    return total;
}

// len returns the visible length of s in columns. It skips the escape
// sequences. An ambiguous code point takes one column.
fn len(s: u8[:]) -> i64 {
    return len_with(s, true, false);
}
