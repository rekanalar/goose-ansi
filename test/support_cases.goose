        if i == lines.len || lines[i] == '\n' {
            let line = lines[start..i];
            var eq = 0;
            while eq < line.len && line[eq] != '=' { eq += 1; }
            if eq < line.len { ansi::color_env_set(e, line[0..eq], line[eq + 1..]); }
            start = i + 1;
        }
        i += 1;
    }
    var args: const u8[:][>..] = [];
    split_args(flags, args);
    let f = ansi::color_flags(args[..]);
    let got = ansi::color_level_env(tty, e, f);
    if got != want { print("FAIL case ", id, " tty=", tty, " env=[", lines, "] flags=[", flags, "] want ", want, " got ", got); }
    assert(got == want);
}

