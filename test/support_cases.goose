// split_args cuts the text at spaces into an argument list.
fn split_args(text: const u8[:], out: const u8[:][>..]&) {
    var start = 0;
    var i = 0;
    while i <= text.len {
        if i == text.len || text[i] == ' ' {
            if i > start { out.push(text[start..i]); }
            start = i + 1;
        }
        i += 1;
    }
}

// level_case sets each NAME=value line of the text, then checks the level.
fn level_case(id: i64, tty: bool, lines: const u8[:], flags: const u8[:], want: i64) {
