fn check_hex_bad() {
    hexbad_case("");
    hexbad_case("#");
    hexbad_case("zz");
    hexbad_case("#ff88");
    hexbad_case("#ff88001");
    hexbad_case("gg0000");
    hexbad_case("#12");
    hexbad_case("12345");
    hexbad_case("#1234567");
    hexbad_case(" fff");
    hexbad_case("#ff 88");
    hexbad_case("0xff8800");
    hexbad_case("#ff880g");
    hexbad_case("##fff");
}

