namespace chalk_cases;

import std;
import ansi from "..";

fn same(got: u8[>..]&, want: const u8[:]) {
    if got[..] != want { print("FAIL got ", got[..], " want ", want); }
    assert(got[..] == want);
}

fn modifier_case(want_overline: const u8[:], want_hidden: const u8[:]) {
    var o: u8[>..] = [];
    ansi::overline(o, "x");
    same(o, want_overline);
    o = [];
    ansi::hidden(o, "x");
    same(o, want_hidden);
}

fn color_case(r: i64, g: i64, b: i64, n: i64, level: i64, want_rgb: const u8[:], want_256: const u8[:]) {
    var o: u8[>..] = [];
    ansi::underline_rgb_at(o, "x", r, g, b, level);
    same(o, want_rgb);
    o = [];
    ansi::underline_color256_at(o, "x", n, level);
    same(o, want_256);
}

fn hex_case(text: const u8[:], level: i64, want_fg: const u8[:], want_bg: const u8[:], want_ul: const u8[:]) {
    var o: u8[>..] = [];
    assert(ansi::hex_at(o, "x", text, level));
    same(o, want_fg);
    o = [];
    assert(ansi::bg_hex_at(o, "x", text, level));
    same(o, want_bg);
    o = [];
    assert(ansi::underline_hex_at(o, "x", text, level));
    same(o, want_ul);
}

fn lower_case(n: i64, r: i64, g: i64, b: i64, level: i64, want_n: const u8[:], want_bg_n: const u8[:], want_rgb: const u8[:], want_bg_rgb: const u8[:]) {
    var o: u8[>..] = [];
    ansi::color256_at(o, "x", n, level);
    same(o, want_n);
    o = [];
    ansi::bg_color256_at(o, "x", n, level);
    same(o, want_bg_n);
    o = [];
    ansi::truecolor_at(o, "x", r, g, b, level);
    same(o, want_rgb);
    o = [];
    ansi::bg_truecolor_at(o, "x", r, g, b, level);
    same(o, want_bg_rgb);
}

fn hexbad_case(text: const u8[:]) {
    var o: u8[>..] = [];
    assert(!ansi::hex_at(o, "x", text, 3));
    assert(!ansi::bg_hex_at(o, "x", text, 3));
    assert(!ansi::underline_hex_at(o, "x", text, 3));
    assert(o.len == 0);
}

fn level_case(tty: bool, force: const u8[:], term: const u8[:], colorterm: const u8[:], want: i64) {
    assert(ansi::color_level_tty(tty, false, term, colorterm, force) == want);
}

